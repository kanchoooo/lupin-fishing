{
  "name": "lupin-fishing",
  "version": "0.1.1",
  "private": true,
  "description": "월급루팡 낚시터 — 일하는 척하면서 화면 구석에서 낚시하는 도트 게임",
  "main": "./out/main/index.js",
  "author": "kanchoooo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "node scripts/build-mac.mjs",
    "dist:mac:local": "node scripts/fetch-koffi.mjs darwin-x64 darwin-arm64 && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --publish never",
    "dist:win": "node scripts/fetch-koffi.mjs win32-x64 && electron-vite build && electron-builder --win --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kanchoooo/lupin-fishing.git"
  }
}
